{
  "version": "7.1.3",
  "sourceUrl": "https://ffmpeg.org/releases/ffmpeg-7.1.3.tar.xz",
  "sourceSha256": "f0bf043299db9e3caacb435a712fc541fbb07df613c4b893e8b77e67baf3adbe",
  "license": "LGPL-2.1-or-later",
  "target": "darwin-arm64",
  "configure": [
    "--disable-autodetect",
    "--disable-everything",
    "--disable-network",
    "--disable-doc",
    "--disable-debug",
    "--disable-shared",
    "--enable-static",
    "--disable-gpl",
    "--disable-nonfree",
    "--disable-version3",
    "--enable-pthreads",
    "--enable-videotoolbox",
    "--enable-ffmpeg",
    "--enable-ffprobe",
    "--enable-protocol=file,pipe",
    "--enable-demuxer=mov,matroska,wav,mp3,ogg,flac,image2",
    "--enable-decoder=h264,hevc,vp8,vp9,av1,aac,mp3,pcm_s16le,pcm_f32le,png,mjpeg,webp,opus,vorbis,flac,wrapped_avframe,rawvideo",
    "--enable-encoder=h264_videotoolbox,aac,pcm_s16le,rawvideo,png,wrapped_avframe",
    "--enable-muxer=mp4,mov,null,rawvideo,wav,image2,pcm_s16le",
    "--enable-parser=h264,hevc,vp8,vp9,av1,aac,mpegaudio,opus,vorbis,png,mjpeg,flac",
    "--enable-filter=aformat,aresample,atrim,asetpts,apad,anullsrc,volume,amix,concat,scale,pad,setsar,fps,format,setpts,trim,color,sine,testsrc2,astats,silencedetect,anull,null",
    "--enable-indev=lavfi"
  ]
}
