{
  "extends": "./tsconfig.base.json",
  "compilerOptions": { "types": ["node"], "lib": ["ES2023", "DOM"] },
  "include": [
    "electron.vite.config.ts",
    "vitest.config.ts",
    "playwright.config.ts",
    "src/main/**/*.ts",
    "src/preload/**/*.ts",
    "src/renderer/env.d.ts",
    "packages/**/*.ts",
    "tests/**/*.ts"
  ],
  "exclude": ["packages/agent-runtime/upstream"]
}
