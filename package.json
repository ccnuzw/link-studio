{
  "name": "link-studio",
  "version": "0.1.0",
  "private": true,
  "description": "灵可 Link Studio — 本地优先的视频创作生产工具",
  "type": "module",
  "main": "./out/main/index.js",
  "packageManager": "pnpm@10.26.2",
  "engines": {
    "node": ">=22.19.0 <23"
  },
  "scripts": {
    "icons:generate": "node scripts/generate-icons.mjs",
    "dev": "electron-vite dev",
    "build": "pnpm provider:build && pnpm media:build && pnpm agent:build && electron-vite build",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "lint": "biome check . && node scripts/check-boundaries.mjs",
    "format": "biome check --write .",
    "test": "vitest run --project unit",
    "provider:build": "node scripts/build-provider-runner.mjs",
    "test:provider": "pnpm provider:build && vitest run --project integration tests/integration/provider-runtime.test.ts",
    "media:build": "node scripts/build-media.mjs",
    "test:media": "pnpm media:build && vitest run --project integration tests/integration/media-composition.test.ts",
    "test:agent:upstream": "node --disable-warning=ExperimentalWarning scripts/test-agent-upstream.mjs",
    "agent:build": "node scripts/build-agent.mjs",
    "test:agent": "pnpm agent:build && vitest run --project integration tests/integration/agent-runtime.test.ts && pnpm test:agent:upstream",
    "test:integration": "pnpm provider:build && pnpm media:build && pnpm agent:build && vitest run --project integration",
    "test:e2e": "pnpm build && playwright test",
    "package:mac": "pnpm build && electron-builder --mac dir --publish never",
    "package:win": "pnpm build && electron-builder --win dir --x64 --publish never"
  },
  "dependencies": {
    "@earendil-works/chord": "1.4.0",
    "@earendil-works/pi-ai": "1.4.0",
    "@earendil-works/pi-codemode": "1.4.0",
    "@earendil-works/pi-durable": "1.4.0",
    "@link-studio/core": "workspace:*",
    "@modelcontextprotocol/sdk": "1.32.1",
    "@sinclair/typebox": "0.34.52",
    "@xyflow/react": "12.12.1",
    "fs-native-extensions": "1.5.4",
    "lucide-react": "1.75.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "typebox": "1.3.27",
    "zustand": "5.0.16"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.8",
    "@playwright/test": "1.65.1",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "electron": "45.4.1",
    "electron-builder": "26.18.0",
    "electron-vite": "6.0.0",
    "typescript": "7.0.2",
    "vite": "8.3.8",
    "vitest": "4.1.12"
  }
}
